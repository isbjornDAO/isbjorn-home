{
  "name": "isbjorn-platform",
  "version": "1.0.0",
  "description": "Avalanche-powered nonprofit donation platform for polar bear conservation",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "start:prod": "npm run start --workspace=backend",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "deploy": "docker-compose up -d",
    "contracts:deploy": "cd smart-contracts && npx hardhat run scripts/deploy.ts"
  },
  "main": "backend/dist/server.js",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "axios": "^1.13.2"
  },
  "overrides": {
    "x402": "^0.7.3"
  }
}
