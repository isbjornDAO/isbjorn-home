# ==============================================
# ISBJORN PLATFORM - ENVIRONMENT CONFIGURATION  
# ==============================================
# Copy to .env and update with your actual values

# ==============================================
# 🌐 GENERAL CONFIGURATION
# ==============================================
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ==============================================
# 💾 DATABASE CONFIGURATION
# ==============================================
# MongoDB (Primary Database)
MONGODB_URI=mongodb://localhost:27017/isbjorn

# Production MongoDB (MongoDB Atlas recommended)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/isbjorn?retryWrites=true&w=majority

# Legacy PostgreSQL (deprecated - use MongoDB)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=isbjorn_dev
# DB_USER=postgres
# DB_PASSWORD=postgres

# ==============================================
# ⚡ REDIS CONFIGURATION
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379 # Alternative format for cloud Redis

# ==============================================
# 🔐 JWT AUTHENTICATION
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-very-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-also-change-this
JWT_REFRESH_EXPIRES_IN=30d

# ==============================================
# 💳 STRIPE PAYMENT PROCESSING
# ==============================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_51234567890abcdef... # Use sk_live_ for production
STRIPE_PUBLIC_KEY=pk_test_51234567890abcdef... # Use pk_live_ for production
STRIPE_WEBHOOK_SECRET=whsec_1234567890abcdef...

# Frontend environment variable (prefix with VITE_)
VITE_STRIPE_PUBLIC_KEY=pk_test_51234567890abcdef...

# ==============================================
# 📧 SENDGRID EMAIL AUTOMATION  
# ==============================================
# Get API key from https://sendgrid.com/
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@isbjorn.co.nz
SENDGRID_FROM_NAME=Isbjorn Arctic Conservation

# Email templates (SendGrid template IDs)
SENDGRID_DONATION_RECEIPT_TEMPLATE=d-1234567890abcdef
SENDGRID_WELCOME_TEMPLATE=d-abcdef1234567890
SENDGRID_MONTHLY_REPORT_TEMPLATE=d-567890abcdef1234

# ==============================================
# ⛄ AVALANCHE BLOCKCHAIN CONFIGURATION
# ==============================================
# Testnet (Fuji) - for development
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_CHAIN_ID=43113

# Mainnet - for production
# AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# AVALANCHE_CHAIN_ID=43114

# Wallet Configuration (KEEP SECURE!)
AVALANCHE_PRIVATE_KEY=0x1234567890abcdef... # Your wallet private key
AVALANCHE_TREASURY_ADDRESS=0x1234567890123456789012345678901234567890

# Smart Contract Addresses (Set after deployment)
DONATION_TRACKER_ADDRESS=0x1234567890123456789012345678901234567890
PROJECT_DISTRIBUTION_ADDRESS=0x1234567890123456789012345678901234567890  
ADMIN_MULTISIG_ADDRESS=0x1234567890123456789012345678901234567890

# Frontend blockchain configuration
VITE_AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
VITE_AVALANCHE_CHAIN_ID=43113
VITE_TREASURY_ADDRESS=0x1234567890123456789012345678901234567890

# ==============================================
# ☁️ AWS S3 CONFIGURATION (for file storage)
# ==============================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=isbjorn-receipts
AWS_S3_PUBLIC_BUCKET=isbjorn-public-assets

# ==============================================
# 📊 MONITORING & ANALYTICS
# ==============================================
# Sentry for error tracking (get from sentry.io)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Analytics
GA_TRACKING_ID=G-XXXXXXXXXX

# PostHog for product analytics  
POSTHOG_API_KEY=phc_your-posthog-key
POSTHOG_HOST=https://app.posthog.com

# ==============================================
# 🔧 ADMIN CONFIGURATION
# ==============================================
# Default admin user (created on first run)
ADMIN_EMAIL=admin@isbjorn.co.nz
ADMIN_PASSWORD=changethisinproduction123!
ADMIN_COMPANY_NAME=Isbjorn Foundation

# Additional admin wallet addresses for multisig
ADMIN_ADDRESS_1=0x1234567890123456789012345678901234567890
ADMIN_ADDRESS_2=0x2345678901234567890123456789012345678901
ADMIN_ADDRESS_3=0x3456789012345678901234567890123456789012
ADMIN_ADDRESS_4=0x4567890123456789012345678901234567890123

# ==============================================
# 💼 BUSINESS COMPLIANCE (New Zealand)
# ==============================================
# New Zealand tax compliance
NZ_GST_NUMBER=123-456-789
NZ_CHARITY_NUMBER=CC12345
NZ_COMPANY_NUMBER=1234567

# Business details for receipts
CHARITY_NAME=Isbjorn Foundation
CHARITY_ADDRESS_STREET=123 Conservation Street
CHARITY_ADDRESS_CITY=Wellington
CHARITY_ADDRESS_STATE=Wellington
CHARITY_ADDRESS_POSTAL=6011  
CHARITY_ADDRESS_COUNTRY=New Zealand
CHARITY_PHONE=+64 4 123 4567
CHARITY_EMAIL=info@isbjorn.co.nz
CHARITY_WEBSITE=https://isbjorn.co.nz

# ==============================================
# 🚀 DEPLOYMENT CONFIGURATION
# ==============================================
# Railway deployment
RAILWAY_STATIC_URL=https://your-app-name.up.railway.app

# Custom domain
CUSTOM_DOMAIN=donate.isbjorn.co.nz

# CDN Configuration  
CDN_URL=https://cdn.isbjorn.co.nz

# ==============================================
# 🧪 TESTING CONFIGURATION  
# ==============================================
# Test database (separate from development)
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=isbjorn_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres

# Test email (use Mailtrap or similar)
TEST_SENDGRID_API_KEY=SG.your-test-key
TEST_EMAIL_FROM=test@isbjorn.local

# ==============================================
# 🔒 SECURITY CONFIGURATION
# ==============================================
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Session security
SESSION_SECRET=another-super-secret-key-for-sessions
COOKIE_SECRET=yet-another-secret-for-cookies

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# ==============================================
# 📝 LOGGING CONFIGURATION
# ==============================================
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/app.log

# External logging service
# PAPERTRAIL_HOST=logs.papertrailapp.com
# PAPERTRAIL_PORT=12345

# ==============================================
# 🔮 API KEYS & INTEGRATIONS
# ==============================================
# CoinMarketCap for price data
COINMARKETCAP_API_KEY=your-cmc-api-key

# Snowtrace for contract verification
SNOWTRACE_API_KEY=your-snowtrace-api-key

# OpenWeather for Arctic climate data
OPENWEATHER_API_KEY=your-openweather-key

# ==============================================
# 💡 DEVELOPMENT HELPERS
# ==============================================
# Enable API documentation in production (set to false for security)
ENABLE_API_DOCS=true

# Enable debug logging
DEBUG=isbjorn:*

# Hot reload for development
CHOKIDAR_USEPOLLING=true

# ==============================================
# ⚙️ PERFORMANCE TUNING
# ==============================================
# Database connection pooling
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Cache TTL (Time To Live) in seconds
CACHE_TTL=3600  # 1 hour
DONATION_CACHE_TTL=300  # 5 minutes
PROJECT_CACHE_TTL=600   # 10 minutes

# ==============================================
# 🎯 FEATURE FLAGS
# ==============================================
ENABLE_RECURRING_DONATIONS=true
ENABLE_CORPORATE_MATCHING=true
ENABLE_IMPACT_CERTIFICATES=true
ENABLE_SOCIAL_SHARING=true
ENABLE_MULTILANG_SUPPORT=false

# ==============================================
# 📞 SUPPORT & CONTACT
# ==============================================
SUPPORT_EMAIL=support@isbjorn.co.nz
SUPPORT_PHONE=+64 4 123 4567
SUPPORT_HOURS=Mon-Fri 9AM-5PM NZST

# ==============================================
# 🌍 LOCALIZATION  
# ==============================================
DEFAULT_LOCALE=en-NZ
DEFAULT_TIMEZONE=Pacific/Auckland
DEFAULT_CURRENCY=NZD

# Supported currencies for donations
SUPPORTED_CURRENCIES=NZD,USD,AUD,EUR

# ==============================================
# END OF CONFIGURATION
# ==============================================

# 🔴 SECURITY REMINDER:
# - Never commit this file to version control with real values
# - Use environment-specific .env files for each deployment
# - Rotate secrets regularly, especially in production
# - Use a secrets management service for production deployments