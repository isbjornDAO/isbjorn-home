AVALANCHE_PRIVATE_KEY=
AVALANCHE_CONTRACT_ADDRESS=

# Monitoring - Optional
SENTRY_DSN=

# Development Features
ENABLE_SWAGGER=true
ENABLE_DEBUG_LOGGING=true
MOCK_EXTERNAL_APIS=true