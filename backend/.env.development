# Isbjorn Platform - Development Environment
# Generated for local development

# Database Configuration
NODE_ENV=development
DATABASE_URL=sqlite:./data/isbjorn_dev.sqlite
DB_LOGGING=true

# Server Configuration
PORT=5000
HOST=localhost

# JWT Configuration  
JWT_SECRET=dev_secret_key_change_in_production_please_use_secure_random_string
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=http://localhost:3001

# Redis Configuration (optional for development)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@isbjorn.co.nz
FROM_NAME=Isbjorn Foundation

# Stripe Configuration  
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
PLATFORM_FEE_PERCENTAGE=1.5

# NZ API Keys (for company/charity verification)
NZ_COMPANIES_REGISTER_API_KEY=your_companies_register_api_key_here
NZ_CHARITIES_API_KEY=your_charities_api_key_here

# AWS Configuration (for receipt storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=isbjorn-receipts-dev

# Blockchain Configuration (Avalanche)
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_PRIVATE_KEY=your_private_key_here
AVALANCHE_CONTRACT_ADDRESS=0x_your_contract_address_here

# Monitoring
SENTRY_DSN=your_sentry_dsn_here

# Development Features
ENABLE_SWAGGER=true
ENABLE_DEBUG_LOGGING=true
MOCK_EXTERNAL_APIS=true