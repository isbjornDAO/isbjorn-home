# Isbjorn Platform - Development Environment
# Generated for local development

# Database Configuration
NODE_ENV=development
DATABASE_URL=sqlite:./database.sqlite
DB_LOGGING=true

# Server Configuration
PORT=5001
HOST=localhost

# JWT Configuration  
JWT_SECRET=dev_secret_key_change_in_production_please_use_secure_random_string
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=http://localhost:3001

# Redis Configuration (optional for development)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Email Configuration (SendGrid) - Mock in development
SENDGRID_API_KEY=mock_sendgrid_key_for_development
FROM_EMAIL=noreply@isbjorn.co.nz
FROM_NAME=Isbjorn Foundation

# Stripe Configuration  
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=pk_test_51RvReNDb9rI7Ugq3qcdNnra0XtqsgS89gE0gz9wiRe3ooKbnNaWnXiZTCXucFEAHtKQZDX83jR6PmvyKGUN8pFQx00NO92AAUE
STRIPE_WEBHOOK_SECRET=whsec_dev_mock_webhook_secret
PLATFORM_FEE_PERCENTAGE=1.5

# NZ API Keys (for company/charity verification) - Mock in development
NZ_COMPANIES_REGISTER_API_KEY=mock_companies_api_key
NZ_CHARITIES_API_KEY=mock_charities_api_key

# AWS Configuration (for receipt storage) - Mock in development
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=isbjorn-receipts-dev

# Blockchain Configuration (Avalanche) - Optional
