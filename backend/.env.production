# Isbjorn Platform - Production Environment
NODE_ENV=production

# Database Configuration (MongoDB Atlas)
DATABASE_URL=mongodb+srv://your_username:your_password@cluster0.mongodb.net/isbjorn_prod?retryWrites=true&w=majority
DB_TYPE=mongodb

# Server Configuration
PORT=5000
HOST=0.0.0.0

# JWT Configuration - CHANGE THESE IN PRODUCTION
JWT_SECRET=super_secure_jwt_secret_key_minimum_256_bits_long_for_production_use_only
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=https://isbjorn.co.nz

# Redis Configuration (Redis Cloud)
REDIS_URL=rediss://default:password@redis-cluster.cloud.redislabs.com:port
REDIS_PASSWORD=your_redis_password

# Email Configuration (SendGrid)
SENDGRID_API_KEY=SG.your_production_sendgrid_api_key_here
FROM_EMAIL=donations@isbjorn.co.nz
FROM_NAME=Isbjorn Foundation

# Stripe Configuration (Production Keys)
STRIPE_SECRET_KEY=sk_live_your_production_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_production_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret_here
PLATFORM_FEE_PERCENTAGE=1.5

# NZ Government API Keys
NZ_COMPANIES_REGISTER_API_KEY=your_production_companies_register_api_key_here
NZ_CHARITIES_API_KEY=your_production_charities_api_key_here

# AWS Configuration (Production)
AWS_ACCESS_KEY_ID=your_production_aws_access_key
AWS_SECRET_ACCESS_KEY=your_production_aws_secret_key
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=isbjorn-receipts-prod

# Avalanche L1 Configuration
AVALANCHE_RPC_URL=https://your-avalanche-l1-rpc-endpoint.com
AVALANCHE_PRIVATE_KEY=your_production_avalanche_private_key_here
AVALANCHE_CONTRACT_ADDRESS=0x_your_deployed_contract_address_here
AVALANCHE_CHAIN_ID=your_chain_id_here
AVALANCHE_GAS_PRICE=25000000000

# Monitoring & Logging
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id
LOG_LEVEL=info

# Security
CORS_ORIGIN=https://isbjorn.co.nz,https://www.isbjorn.co.nz
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Features
ENABLE_SWAGGER=false
ENABLE_DEBUG_LOGGING=false
MOCK_EXTERNAL_APIS=false

# NZ IRD Integration
IRD_API_KEY=your_ird_api_key_here
IRD_ENVIRONMENT=production