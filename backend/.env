# Isbjorn Platform - Development Environment
# Generated for local development

# Database Configuration
NODE_ENV=development
DB_TYPE=sqlite
DB_PATH=./data/isbjorn_dev.sqlite
DATABASE_URL=sqlite:./data/isbjorn_dev.sqlite
DB_LOGGING=false

# Server Configuration
PORT=5000
HOST=localhost

# JWT Configuration  
JWT_SECRET=dev_secret_key_change_in_production_please_use_secure_random_string_123456789
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Redis Configuration (optional for development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Email Configuration (SendGrid) - Using mock for development
SENDGRID_API_KEY=SG.mock_development_key_not_real
FROM_EMAIL=noreply@isbjorn.co.nz
FROM_NAME=Isbjorn Foundation
EMAIL_ENABLED=false

